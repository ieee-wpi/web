# Copy to game-server/.env (gitignored) and fill in.
QUIZ_PORT=9001
QUIZ_HOST_PASSWORD=change-me
# "Publish to web" base URL of the QUIZ spreadsheet (not the Wordle one), ending in /pub
QUIZ_SHEET_PUB_BASE=
QUIZ_INDEX_GID=0
# Where quizzes built on /quiz/host are saved (relative to game-server/)
QUIZ_SAVED_DIR=saved-quizzes
QUIZ_MAX_GAMES=3
QUIZ_MAX_PLAYERS=200
QUIZ_ALLOWED_ORIGINS=https://ieee.wpi.edu,https://ieee-dev.wpi.edu,http://localhost:3000
